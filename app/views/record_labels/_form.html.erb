<%= simple_form_for @record_label do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="card">
    <div class="card-body">
      <%= f.input :name, 
          label: 'Nome do Gênero',
          placeholder: 'Ex: Rock, Jazz, Clássica...',
          input_html: { class: 'form-control', autofocus: true } %>
    </div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <%= f.button :submit, 'Salvar', class: 'btn btn-primary' %>
    <%= link_to 'Cancelar', record_labels_path, class: 'btn btn-secondary' %>
  </div>
<% end %>