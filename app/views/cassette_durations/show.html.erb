<div class="row mb-4">
  <div class="col">
    
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h3 class="display-5 mb-0">
          <i class="bi bi-music-note-list"></i> <%= @cassette_duration.name %>
        </h3>
      </div>
      <div class="btn-group">
        <%= link_to cassette_durations_path, class: "btn btn-secondary me-2", yitle: "Voltar Lista" do %>
          <i class="bi bi-box-arrow-left"></i>
        <% end %>
        <%= link_to edit_cassette_duration_path(@cassette_duration), class: "btn btn-warning me-2", title: "Editar" do %>
          <i class="bi bi-pencil"></i> 
        <% end %>
        <%= button_to cassette_duration_path(@cassette_duration), method: :delete,
            data: { turbo_confirm: "Tem certeza que deseja excluir esta tipo de duração fita cassete?" },
            class: "btn btn-danger", title: "Excluir" do %>
          <i class="bi bi-trash"></i> 
        <% end %>
      </div>
    </div>
  </div>
</div>


