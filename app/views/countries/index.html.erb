<div class="row mb-4">
  <div class="col">
    <div class="d-flex justify-content-between align-items-center">
      <h3 class="display-5">
        <i class="bi bi-music-note-list text-primary"></i> País
      </h3>
      <%= link_to new_country_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-circle"></i> Novo País
      <% end %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th >País</th>
            <th class="text-center">Codigo</th>
            <th class="text-center">Bandeira</th>
            <th class="text-center">Midias</th>
            <th class="text-center">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @countries.each do |country| %>
            <tr>
              <td >
                <%= link_to country.name, country, class: 'text-decoration-none fw-semibold' %>
              </td>
              <td class="text-center">
                <span class="text-decoration-none fw-semibold"><%= country.code %></span>
              </td>
              <td class="text-center">
                <span class="me-2 flag-icon flag-icon-<%= country.flag_code.downcase %>"></span>
              </td>
              <td class="text-center">
                <span class="badge bg-secondary"><%= country.media_physicals.count %></span>
              </td>
              <td class="text-center">
                <div class="btn-group" role="group" aria-label="Ações do país">
                  <%= link_to country, class: "btn btn-sm btn-outline-primary me-2", title: "Visualizar" do %>
                    <i class="bi bi-eye"></i> 
                  <% end %>
                  <%= link_to edit_country_path(country), title: "Editar", # <-- CORRIGIDO AQUI: 'contry' para 'country'
                        class: "btn btn-sm btn-outline-warning me-2" do %>
                      <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to country_path(country), method: :delete,
                      data: { turbo_confirm: "Tem certeza? Esta ação não poderá ser desfeita." },
                      class: "btn btn-sm btn-outline-danger", title: "Excluir" do %>
                    <i class="bi bi-trash"></i> 
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @countries.empty? %>
      <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-3">Nenhum País cadastrado</p>
        <%= link_to 'Adicionar primeiro País', new_country_path, class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <%= paginate @countries, theme: 'bootstrap-5' %>
</div>