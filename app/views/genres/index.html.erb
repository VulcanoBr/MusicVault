<div class="row mb-4">
  <div class="col">
    <div class="d-flex justify-content-between align-items-center">
      <h3 class="display-5">
        <i class="bi bi-music-note-list text-primary"></i> Gêneros Musicais
      </h3>
      <%= link_to new_genre_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-circle"></i> Novo Gênero
      <% end %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Gênero</th>
            <!-- Centraliza o cabeçalho e remove a largura fixa -->
            <th class="text-center">Mídias</th>
            <!-- Centraliza o cabeçalho e remove a largura fixa -->
            <th class="text-center">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @genres.each do |genre| %>
            <tr>
              <td>
                <%= link_to genre.name, genre, class: 'text-decoration-none fw-semibold' %>
              </td>
              <td class="text-center">
                <span class="badge bg-secondary"><%= genre.media_physicals.count %></span>
              </td>
              <!-- Centraliza a célula de ações e agrupa os botões -->
              <td class="text-center">
                <div class="btn-group" role="group" aria-label="Ações do gênero">
                  <%= link_to genre, class: "btn btn-sm btn-outline-primary me-2", title: "Visualizar",
                          aria: { label: "Ver detalhes" } do %>
                      <i class="bi bi-eye"></i>
                  <% end %>
                  <%= link_to edit_genre_path(genre), class: "btn btn-sm btn-outline-warning me-2 ", title: "Editar",
                        aria: { label: "Editar gênero" } do %>
                      <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to genre_path(genre), method: :delete,
                      data: { turbo_confirm: "Tem certeza? Esta ação não poderá ser desfeita." },
                      class: "btn btn-sm btn-outline-danger", title: 'Excluir',
                      aria: { label: "Excluir gênero" } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @genres.empty? %>
      <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-3">Nenhum gênero cadastrado</p>
        <%= link_to 'Adicionar primeiro gênero', new_genre_path, class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <%= paginate @genres, theme: 'bootstrap-5' %>
</div>