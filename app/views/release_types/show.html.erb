<div class="row mb-4">
  <div class="col">
    
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h2 class="display-5 mb-0">
          <i class="bi bi-music-note-list"></i> <%= @release_type.name %>
        </h2>
        <p class="text-muted mt-2">
          <i class="bi bi-collection-play"></i> <%= @release_type.media_physicals.count %> mídias cadastradas
        </p>
      </div>
      <div class="btn-group">
        <%= link_to release_types_path, class: "btn btn-secondary me-2", title: "Voltar Lista" do %>
          <i class="bi bi-box-arrow-left"></i>
        <% end %>
        <%= link_to edit_release_type_path(@release_type), class: "btn btn-warning me-2", title: "Editar" do %>
          <i class="bi bi-pencil"></i>
        <% end %>
        <%= button_to release_type_path(@release_type), method: :delete,
            data: { turbo_confirm: "Tem certeza que deseja excluir esta tipo de lançamento?" },
            class: "btn btn-danger", title: "Excluir" do %>
          <i class="bi bi-trash"></i> 
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header bg-dark text-white">
    <h5 class="mb-0">Mídias neste Tipo de Lançamento</h5>
  </div>
  <div class="card-body p-0">
    <% if @media_physicals.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Tipo</th>
              <th>Álbum</th>
              <th>Artista</th>
              <th>Ano</th>
              <th width="100" class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @media_physicals.each do |media_physical| %>
              <tr>
                <td>
                  <span class="badge bg-primary"><%= media_physical.media_type.name %></span>
                </td>
                <td><%= link_to media_physical.album_title, media_physical, class: 'text-decoration-none' %></td>
                <td class="text-muted"><%= media_physical.artist_band %></td>
                <td><%= media_physical.release_year %></td>
                <td class="text-end">
                  <%= link_to media_physical, class: "btn btn-sm btn-outline-primary", title: "Visualizar" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <div class="card-footer">
        <%= paginate @media_physicals, theme: 'bootstrap-5' %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-3">Nenhuma mídia cadastrada neste tipo de lançamento</p>
      </div>
    <% end %>
  </div>
</div>
