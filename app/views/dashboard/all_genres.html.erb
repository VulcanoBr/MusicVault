
<div class="row mb-4">
  <div class="col-12">
    
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h3 class="display-5 mb-0">
        <i class="bi bi-music-note-list text-primary"></i> Todos os Gêneros
      </h3>
      
      <div class="d-flex gap-2 align-items-center">
        <!-- Formulário de busca compacto inline -->
        <%= form_with url: all_genres_path, method: :get, class: "d-flex gap-2" do |f| %>
          <%= f.text_field :search, 
              value: params[:search],
              class: "form-control",
              placeholder: "Buscar gênero...",
              style: "width: 250px;",
              autofocus: params[:search].present? %>
          <%= f.submit "Buscar", class: "btn btn-primary" %>
        <% end %>
        
        <%= link_to dashboard_path, class: "btn btn-secondary" do %>
          <i class="bi bi-arrow-left"></i> Voltar
        <% end %>
      </div>
    </div>
    
    
    <div class="d-flex justify-content-between align-items-center">
      <p class="lead text-muted mb-0">
        Lista completa de gêneros da sua coleção
      </p>
      
      <% if @search_term.present? %>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-info fs-6">
            <i class="bi bi-funnel-fill me-1"></i>
            Filtro: "<%= @search_term %>"
          </span>
          <%= link_to all_genres_path, class: "btn btn-sm btn-outline-secondary" do %>
            <i class="bi bi-x-circle me-1"></i>Limpar
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="card shadow">
  <div class="card-body p-0">
    <% if @genres.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th width="60">#</th>
              <th>Gênero</th>
              <th class="text-center">Quantidade</th>
              <th class="text-center">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @genres.each_with_index do |genre, index| %>
              <tr>
                <td class="text-muted"><%= index + 1 %></td>
                <td>
                  <i class="bi bi-music-note me-2 text-primary"></i>
                  <strong><%= genre.name %></strong>
                </td>
                <td class="text-center">
                  <span class="badge bg-primary rounded-pill fs-6">
                    <%= genre.media_count %> 
                    <%= genre.media_count == 1 ? 'mídia' : 'mídias' %>
                  </span>
                </td>
                <td class="text-center">
                  <%= link_to media_by_genre_path(genre), 
                      class: "btn btn-sm btn-outline-primary" do %>
                    <i class="bi bi-eye me-1"></i>Ver Mídias
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="table-light">
            <tr>
              <td colspan="2" class="text-end"><strong>Total:</strong></td>
              <td class="text-center">
                <strong><%= @genres.sum(&:media_count) %> mídias</strong>
              </td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
        <p class="text-muted mt-3">Nenhum gênero cadastrado</p>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <%= paginate @genres, theme: 'bootstrap-5' %>
</div>