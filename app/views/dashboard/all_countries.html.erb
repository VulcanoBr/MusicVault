
<div class="row mb-4">
  <div class="col">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h3 class="display-5">
          <i class="bi bi-globe2 text-primary"></i> Todos os Países
        </h3>
        <p class="lead text-muted">
          Distribuição da coleção por país
        </p>
      </div>
      <%= link_to dashboard_path, class: "btn btn-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>
</div>

<div class="card shadow">
  <div class="card-body p-0">
    <% if @countries.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th width="60">#</th>
              <th>País</th>
              <th width="150" class="text-center">Quantidade</th>
              <th width="150" class="text-center">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @countries.each_with_index do |country, index| %>
              <tr>
                <td class="text-muted">
                  <%= (@countries.current_page - 1) * @countries.limit_value + index + 1 %>
                </td>
                
                <td>
                  <span class="me-2 flag-icon flag-icon-<%= country.flag_code.downcase %>"></span>
                  <strong><%= country.name %></strong>
                </td>
                <td class="text-center">
                  <span class="badge bg-secondary rounded-pill fs-6">
                    <%= country.media_count %> <%= country.media_count == 1 ? 'mídia' : 'mídias' %>
                  </span>
                </td>
                
                <td class="text-center">
                  <%= link_to media_by_country_path(country), 
                      class: "btn btn-sm btn-outline-primary" do %>
                    <i class="bi bi-eye me-1"></i>Ver Mídias
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="table-light">
            <tr>
              <td colspan="2" class="text-end"><strong>Total nesta página:</strong></td>
              <td class="text-center">
                <strong><%= @countries.sum(&:media_count) %> mídias</strong>
              </td>
              <td colspan="2"></td>
            </tr>
          </tfoot>
        </table>
      </div>
      
      <!-- Paginação -->
      <div class="card-footer">
        <%= paginate @countries, theme: 'bootstrap-5' %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
        <p class="text-muted mt-3">Nenhuma mídia com país de origem</p>
      </div>
    <% end %>
  </div>
</div>