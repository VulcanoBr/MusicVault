
<div class="row mb-4">
  <div class="col-md-4">
    <% if @media_physical.front_cover.attached? %>
      <%= image_tag @media_physical.front_cover.variant(resize_to_limit: [600, 600]), 
                  class: "img-fluid rounded shadow", 
                  alt: @media_physical.album_title %>
    <% else %>
      <div class="bg-secondary rounded shadow d-flex align-items-center justify-content-center" 
          style="height: 400px;">
        <i class="bi bi-music-note-beamed text-white" style="font-size: 6rem;"></i>
      </div>
    <% end %>
    
    <% if @media_physical.back_cover.attached? %>
      <div class="mt-3">
        <h6 class="text-muted">Capa Verso:</h6>
        <%= image_tag @media_physical.back_cover.variant(resize_to_limit: [600, 600]), 
                    class: "img-fluid rounded shadow", 
                    alt: "#{@media_physical.album_title} - Verso" %>
      </div>
    <% end %>
  </div>
  
  <div class="col-md-8">
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
        <span class="badge bg-primary fs-6 mb-2"><%= @media_physical.media_type.name %></span>
        <h1 class="display-5 mb-0"><%= @media_physical.album_title %></h1>
        <h3 class="text-muted"><%= @media_physical.artist_band %></h3>
      </div>
      <div class="btn-group">
        <%= link_to media_physicals_path, class: "btn btn-secondary me-2", title: "Voltar Lista" do %>
          <i class="bi bi-box-arrow-left me-2"></i> <i class="bi bi-music-note-beamed"></i> 
        <% end %>
        <%= link_to edit_media_physical_path(@media_physical), class: "btn btn-warning me-2", title: "Editar" do %>
          <i class="bi bi-pencil"></i> 
        <% end %>
        <%= button_to media_physical_path(@media_physical), method: :delete, 
            data: { turbo_confirm: "Tem certeza que deseja excluir esta mídia?" },
            class: "btn btn-danger", title: "Excluir" do %>
          <i class="bi bi-trash"></i> 
        <% end %>
      </div>
    </div>
    
    <div class="card mb-3">
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <h6 class="text-muted mb-1">Gravadora</h6>
            <p class="mb-0"><%= @media_physical.record_label.name %></p>
          </div>
          
          <% if @media_physical.imprint.present? %>
            <div class="col-md-6 mb-3">
              <h6 class="text-muted mb-1">Selo</h6>
              <p class="mb-0"><%= @media_physical.imprint.name %></p>
            </div>
          <% end %>
          
          <div class="col-md-6 mb-3">
            <h6 class="text-muted mb-1">Gênero</h6>
            <p class="mb-0"><%= @media_physical.genre.name %></p>
          </div>
          
          <div class="col-md-6 mb-3">
            <h6 class="text-muted mb-1">País</h6>
            <div class="d-flex">
            <span class="me-2 flag-icon flag-icon-<%= @media_physical.country.flag_code.downcase %>"></span>
            <p class="mb-0  "><%= @media_physical.country.name %></p>
            </div>
          </div>
          
          <div class="col-md-6 mb-3">
            <h6 class="text-muted mb-1">Ano de Lançamento</h6>
            <p class="mb-0"><%= @media_physical.release_year %></p>
          </div>
          
          <div class="col-md-6 mb-3">
            <h6 class="text-muted mb-1">Tipo de Lançamento</h6>
            <p class="mb-0"><%= @media_physical.release_type.name %></p>
          </div>
          
          <% if @media_physical.barcode.present? %>
            <div class="col-md-6 mb-3">
              <h6 class="text-muted mb-1">Código de Barras</h6>
              <p class="mb-0"><code><%= @media_physical.barcode %></code></p>
            </div>
          <% end %>
          
          <div class="col-md-6 mb-3">
            <h6 class="text-muted mb-1">Duração Total</h6>
            <p class="mb-0"><%= @media_physical.total_duration || '--:--:--' %></p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Detalhes específicos da mídia -->
    <% if @media_physical.media_detail.present? %>
      <div class="card mb-3">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Detalhes do <%= @media_physical.media_type.name %></h5>
        </div>
        <div class="card-body">
          <%= render "media_physicals/details/#{@media_physical.media_type.name.parameterize.underscore}",
                                detail: @media_physical.media_detail %>
        </div>
      </div>
    <% end %>
    
    <% if @media_physical.general_notes.present? %>
      <div class="alert alert-info">
        <h6 class="alert-heading">Observações</h6>
        <%= simple_format @media_physical.general_notes %>
      </div>
    <% end %>
  </div>
</div>

<!-- Faixas -->
<div class="card">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><i class="bi bi-music-note-list"></i> Faixas (<%= @tracks.count %>)</h5>
    <%= link_to new_media_physical_track_path(@media_physical), class: "btn btn-sm btn-light" do %>
      <i class="bi bi-plus-circle"></i> Adicionar Faixa
    <% end %>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th width="50">#</th>
            <% if @media_physical.vinyl? || @media_physical.cassette? %>
              <th >Lado</th>
            <% end %>
            <% if !@media_physical.cassette? %>
              <th >Disco</th>
            <% end %>
            <th>Título</th>
            <th>Artista</th>
            <th >Duração</th>
            <th  >Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @tracks.each do |track| %>
            <tr>
              <td><strong><%= track.track_number %></strong></td>
              <% if @media_physical.vinyl? || @media_physical.cassette? %>
                <td><span class="badge bg-secondary"><%= track.side %></span></td>
              <% end %>
              <% if !@media_physical.cassette? %>
                <td><%= track.disc_number %></td>
              <% end %>
              <td><%= track.track_title %></td>
              <td class=""><%= track.track_artist_name.presence || @media_physical.artist_band %></td>
              <td><%= track.formatted_duration %></td>
              <td>
                <div class="btn-group btn-group-sm" role="group">
                  <%= link_to "#", 
                      class: "btn btn-outline-info",
                      data: { bs_toggle: "modal", bs_target: "#trackModal#{track.id}" },
                      title: "Ver Detalhes" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                  <%= link_to edit_media_physical_track_path(@media_physical, track), class: "btn btn-sm btn-outline-warning me-2" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to media_physical_track_path(@media_physical, track), method: :delete,
                      data: { turbo_confirm: "Excluir esta faixa?" },
                      class: "btn btn-sm btn-outline-danger" do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
            <!-- Renderiza o modal para esta track -->
            <%= render partial: 'tracks/detail_modal', 
                    locals: { track: track, media_physical: @media_physical } %>
            <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @tracks.empty? %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-music-note" style="font-size: 2rem;"></i>
        <p class="mt-2">Nenhuma faixa cadastrada</p>
      </div>
    <% end %>
  </div>
</div>

