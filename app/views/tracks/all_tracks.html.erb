<div class="row mb-4">
  <div class="col">
    <h3 class="display-5">
      <i class="bi bi-music-note-list text-primary"></i> Todas as Faixas
    </h3>
   
  </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">
      <i class="bi bi-funnel me-2"></i>Filtros
    </h5>
  </div>
  <div class="card-body">
    <%= form_with url: all_tracks_path, method: :get, class: "row g-3" do |f| %>
      <div class="col-md-3">
        <%= f.label :genre_id, "Gênero", class: "form-label" %>
        <%= f.select :genre_id, 
            options_from_collection_for_select(@genres, :id, :name, params[:genre_id]),
            { include_blank: "Todos" }, 
            class: "form-select" %>
      </div>
      
      <div class="col-md-3">
        <%= label_tag :artist, "Artista/Banda", class: "form-label" %>
        <%= text_field_tag :artist, params[:artist], 
            class: "form-control", 
            placeholder: "Nome do artista..." %>
      </div>
      
      <div class="col-md-4">
        <%= label_tag :track_name, "Nome da Faixa", class: "form-label" %>
        <%= text_field_tag :track_name, params[:track_name], 
            class: "form-control", 
            placeholder: "Nome da música..." %>
      </div>
      
      <div class="col-md-2 d-flex align-items-end">
        <%= submit_tag "Filtrar", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Estatísticas -->
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card bg-primary text-white">
      <div class="card-body text-center">
        <h3 class="mb-0"><%= @tracks.total_count %></h3>
        <small>Faixas Encontradas</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-info text-white">
      <div class="card-body text-center">
        <h3 class="mb-0"><%= @tracks.current_page %></h3>
        <small>Página Atual</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-success text-white">
      <div class="card-body text-center">
        <h3 class="mb-0"><%= @tracks.total_pages %></h3>
        <small>Total de Páginas</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-warning text-dark">
      <div class="card-body text-center">
        <h3 class="mb-0">10</h3>
        <small>Faixas por Página</small>
      </div>
    </div>
  </div>
</div>

<!-- Tabela de Tracks -->
<div class="card shadow">
  <div class="card-header bg-dark text-white">
    <h5 class="mb-0">
      <i class="bi bi-list-ul me-2"></i>Lista de Faixas
    </h5>
  </div>
  <div class="card-body p-0">
    <% if @tracks.any? %>
      <div class="table-responsive">
        <table class="table table-hover table-striped mb-0">
          <thead class="table-light">
            <tr>
              <th width="80">
                <i class="bi bi-disc me-1"></i>Tipo
              </th>
              <th>
                <i class="bi bi-collection me-1"></i>Álbum
              </th>
              <th>
                <i class="bi bi-person me-1"></i>Artista/Banda
              </th>
              <th>
                <i class="bi bi-music-note me-1"></i>Faixa
              </th>
              <th width="100">
                <i class="bi bi-clock me-1"></i>Duração
              </th>
              <th width="120" class="text-center">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @tracks.each do |track| %>
              <tr>
                <td>
                  <span class="badge bg-primary">
                    <%= track.media_physical.media_type.name %>
                  </span>
                </td>
                <td>
                  <%= link_to track.media_physical.album_title, 
                      media_physical_path(track.media_physical), 
                      class: "text-decoration-none fw-semibold" %>
                  <br>
                  <small class="text-muted">
                    <i class="bi bi-tag me-1"></i>
                    <%= track.media_physical.genre.name %>
                  </small>
                </td>
                <td>
                  <%= track.media_physical.artist_band %>
                </td>
                <td>
                  <strong><%= track.track_number %>.</strong>
                  <%= track.track_title %>
                  <% if track.track_artist_name.present? %>
                    <br>
                    <small class="text-muted">
                      <i class="bi bi-mic me-1"></i>
                      <%= track.track_artist_name %>
                    </small>
                  <% end %>
                  <% if track.featured_artist.present? %>
                    <br>
                    <span class="badge bg-info text-dark">
                      Feat. <%= track.featured_artist %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <span class="badge bg-secondary">
                    <%= track.formatted_duration || '--:--' %>
                  </span>
                </td>
                <td class="text-center">
                  <div class="btn-group btn-group-sm" role="group">
                    <!-- Ver Detalhes -->
                    <%= link_to "#", 
                        class: "btn btn-outline-info me-2",
                        data: { bs_toggle: "modal", bs_target: "#trackModal#{track.id}" },
                        title: "Ver Detalhes" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    
                    <!-- Ver Álbum -->
                    <%= link_to media_physical_path(track.media_physical), 
                        class: "btn btn-outline-primary",
                        title: "Ver Álbum" do %>
                      <i class="bi bi-collection"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
              
              <!-- Modal de Detalhes -->
              <%= render partial: 'tracks/detail_modal_standalone', 
                         locals: { track: track, media_physical: track.media_physical } %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
        <p class="text-muted mt-3 mb-0">Nenhuma faixa encontrada com os filtros aplicados</p>
        <%= link_to "Limpar Filtros", all_tracks_path, class: "btn btn-outline-primary mt-3" %>
      </div>
    <% end %>
  </div>
  
  <% if @tracks.any? %>
    <div class="card-footer">
      <%= paginate @tracks, theme: 'bootstrap-5' %>
    </div>
  <% end %>
</div>