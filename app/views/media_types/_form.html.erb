<%= simple_form_for @media_type do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="card">
    <div class="card-body">
      <%= f.input :name, 
          label: 'Tipo de Midia',
          placeholder: 'Ex: Vinil, CD, DVD...',
          input_html: { class: 'form-control', autofocus: true } %>
    </div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <%= f.button :submit, 'Salvar', class: 'btn btn-primary' %>
    <%= link_to 'Cancelar', media_types_path, class: 'btn btn-secondary' %>
  </div>
<% end %>