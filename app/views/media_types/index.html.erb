<div class="row mb-4">
  <div class="col">
    <div class="d-flex justify-content-between align-items-center">
      <h3 class="display-5">
        <i class="bi bi-music-note-list text-primary"></i> Tipos de Midia
      </h3>
      <%= link_to new_media_type_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-circle"></i> Novo Tipo de Midia
      <% end %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Midia</th>
            <th  class="text-center">Mídias</th>
            <th  class="text-center">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @media_types.each do |media_type| %>
            <tr>
              <td>
                <%= link_to media_type.name, media_type, class: 'text-decoration-none fw-semibold' %>
              </td>
              <td class="text-center">
                <span class="badge bg-secondary"><%= media_type.media_physicals.count %></span>
              </td>
              <td class="text-center">
                <div class="btn-group" role="group" aria-label="Ações do Tipos de Midia">
                  <%= link_to media_type, class: "btn btn-sm btn-outline-primary me-2", title: "Visualizar" do %>
                    <i class="bi bi-eye"></i> 
                  <% end %>
                  <%= link_to edit_media_type_path(media_type), title: "Editar", 
                        class: "btn btn-sm btn-outline-warning me-2" do %>
                      <i class="bi bi-pencil"></i> 
                  <% end %>
                  <%= button_to media_type_path(media_type), method: :delete,
                      data: { turbo_confirm: "Tem certeza? Esta ação não poderá ser desfeita." },
                      class: "btn btn-sm btn-outline-danger", title: "Excluir" do %>
                    <i class="bi bi-trash"></i> 
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @media_types.empty? %>
      <div class="text-center py-5">
        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-3">Nenhum tipo de midia cadastrado</p>
        <%= link_to 'Adicionar primeira Tipo de Midia', new_media_type_path, class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <%= paginate @media_types, theme: 'bootstrap-5' %>
</div>